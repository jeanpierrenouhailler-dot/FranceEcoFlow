# Copy to .env and replace every placeholder before starting the services.
POSTGRES_USER=flowuser
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=flowdb
DATABASE_URL=postgres://flowuser:replace-with-a-strong-password@postgres:5432/flowdb

# Optional source credentials; connectors remain unavailable until real extraction is implemented.
COMTRADE_API_KEY=
EIA_API_KEY=
GEMINI_API_KEY=
# Allowed application origin(s), comma-separated in deployments that need multiple origins.
APP_URL=
# Shared admin credential required by POST /api/sources/ingest; keep empty to disable it.
INGESTION_ADMIN_TOKEN=
